{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64" },
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build-fast",
      "environment": { "VCPKG_ROOT": "C:/vcpkg" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
