        "CMAKE_CXX_FLAGS": "/EHsc /MP /W4 /external:anglebrackets /external:W0 $penv{CXXFLAGS}",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "RPS_UI_FRAMEWORK_BUILD_TESTS": true,
        "POST_BUILD_COPY_PLUGIN": false
      }
    },
    {
      "name": "fast",
      "inherits": "base"
    }
  ]
}
